DJANGO_DEBUG=0
FACDOWNLOADER_PORT=18000
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SECURE_SSL_REDIRECT=1
CSRF_COOKIE_SECURE=1
SESSION_COOKIE_SECURE=1
SECURE_HSTS_SECONDS=31536000
CSRF_TRUSTED_ORIGINS=https://facdownloader.interno.local
DATABASE_URL=postgresql://facdownloader:facdownloader@postgres:5432/facdownloader
REDIS_URL=redis://redis:6379/0
DOWNLOAD_TEMP_ROOT=/data/downloads
DOWNLOAD_RETENTION_HOURS=24
# Genera con: docker compose exec web python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
GRAPH_TIMEOUT_SECONDS=60
# Descargas directas simultáneas por lote; mantén un valor moderado para no saturar proveedores.
DOWNLOAD_HTTP_CONCURRENCY=4
# Remitentes adicionales permitidos solo para pruebas, separados por comas.
INVOICE_TEST_SENDERS=
